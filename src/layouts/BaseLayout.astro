---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.pitch } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} · ${profile.handle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const nav = [
  { href: '/#experience', label: '经历' },
  { href: '/#projects', label: '项目' },
  { href: '/#skills', label: '技能' },
  { href: '/blog/', label: '博客', match: '/blog' },
  { href: '/tags/', label: '标签', match: '/tags' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} 的博客`} href="/rss.xml" />
    <meta name="theme-color" content="#0d1117" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand mono" href="/">
          <span class="prompt">~/</span>{profile.handle}<span class="cursor">_</span>
        </a>
        <nav aria-label="主导航">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={['nav-link', { active: item.match && path.startsWith(item.match) }]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner mono">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span class="footer-links">
          <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
          <a href="/rss.xml">RSS</a>
          <span class="dim">built with Astro</span>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(13, 17, 23, 0.85);
    backdrop-filter: saturate(160%) blur(8px);
    -webkit-backdrop-filter: saturate(160%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 56px;
  }
  .brand {
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .prompt {
    color: var(--accent);
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-link {
    color: var(--text-dim);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.925rem;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    background: var(--bg-elev);
    text-decoration: none;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 20px 0;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
  .footer-links {
    display: flex;
    gap: 16px;
  }
  @media (max-width: 520px) {
    .header-inner {
      height: auto;
      padding-top: 10px;
      padding-bottom: 8px;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
    nav {
      margin-left: -10px;
      max-width: calc(100% + 10px);
    }
  }
</style>
