---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTagCounts, tagUrl } from '../../lib/posts';

const tags = getTagCounts(await getPosts());
---

<BaseLayout title="标签">
  <h1 class="page-title mono"><span class="accent">$</span> ls ./tags</h1>
  <p class="dim">共 {tags.length} 个标签。</p>
  <div class="tags tag-cloud">
    {
      tags.map(([tag, count]) => (
        <a class="tag" href={tagUrl(tag)}>
          #{tag} <span class="dim">({count})</span>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-title {
    font-size: 1.6rem;
    margin: 0 0 4px;
  }
  .accent {
    color: var(--accent);
  }
  .tag-cloud {
    gap: 10px;
  }
  .tag-cloud .tag {
    font-size: 0.9rem;
    padding: 4px 12px;
  }
</style>
