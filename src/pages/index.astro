---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { profile, experiences, projects, skills } from '../data/profile';
import { getPosts } from '../lib/posts';

const latestPosts = (await getPosts()).slice(0, 3);
const hasEmail = !profile.email.startsWith('TODO');
---

<BaseLayout>
  <section class="hero">
    <p class="mono dim whoami">$ whoami</p>
    <h1>
      {profile.name}
      <span class="name-en mono">{profile.nameEn}</span>
    </h1>
    <p class="pitch">{profile.pitch}</p>
    <p class="status dim">{profile.status}</p>
    <div class="targets">
      <span class="mono dim">求职方向:</span>
      {profile.targets.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="links">
      <a class="btn primary" href={profile.github} target="_blank" rel="noopener">GitHub @{profile.handle}</a>
      {
        hasEmail ? (
          <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
        ) : (
          <span class="btn disabled" title="在 src/data/profile.ts 中填写 email">
            邮箱 <span class="badge-todo">TODO</span>
          </span>
        )
      }
      {
        profile.resumeUrl ? (
          <a class="btn" href={profile.resumeUrl} download>
            下载简历 PDF
          </a>
        ) : (
          <a class="btn disabled" href="#resume">
            简历 <span class="badge-todo">待上传</span>
          </a>
        )
      }
    </div>
  </section>

  <section id="experience" class="section">
    <h2 class="section-title">经历 <span class="en">experience</span></h2>
    <ol class="timeline">
      {
        experiences.map((exp) => (
          <li class="timeline-item">
            <div class="timeline-head">
              <h3>
                {exp.company} <span class="role">· {exp.role}</span>
              </h3>
              <span class="mono dim period">{exp.period}</span>
            </div>
            <ul class="highlights">
              {exp.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <div class="tags">
              {exp.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </li>
        ))
      }
      <li class="timeline-item edu">
        <div class="timeline-head">
          <h3>广东工业大学 <span class="role">· 人工智能 硕士</span></h3>
          <span class="mono dim period">TODO – 2027.06</span>
        </div>
      </li>
    </ol>
  </section>

  <section id="projects" class="section">
    <h2 class="section-title">项目 <span class="en">projects</span></h2>
    <div class="grid">
      {
        projects.map((p) => (
          <article class:list={['card', 'project', { placeholder: p.placeholder }]}>
            <div class="project-head">
              <span class="mono project-cat">{p.category === 'robotics' ? '[robotics]' : '[ai-app]'}</span>
              {p.placeholder && <span class="badge-todo">占位示例</span>}
            </div>
            <h3>{p.title}</h3>
            <p class="dim">{p.summary}</p>
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            {(p.repo || p.demo) && (
              <div class="project-links mono">
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener">
                    源码 →
                  </a>
                )}
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener">
                    演示 →
                  </a>
                )}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section id="skills" class="section">
    <h2 class="section-title">技能 <span class="en">skills</span></h2>
    <dl class="skills card">
      {
        skills.map((g) => (
          <div class="skill-row">
            <dt class="mono">{g.name}</dt>
            <dd class="tags">
              {g.items.map((s) =>
                s === 'TODO' ? <span class="badge-todo">TODO</span> : <span class="tag">{s}</span>,
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="resume" class="section">
    <h2 class="section-title">简历 <span class="en">resume</span></h2>
    <div class="card resume">
      {
        profile.resumeUrl ? (
          <>
            <p>完整简历（PDF）：</p>
            <a class="btn primary" href={profile.resumeUrl} download>
              下载简历
            </a>
          </>
        ) : (
          <>
            <p class="dim">
              <span class="badge-todo">TODO</span> 简历 PDF 待上传：放到 <code class="mono">public/resume.pdf</code>，
              并在 <code class="mono">src/data/profile.ts</code> 中设置 <code class="mono">resumeUrl: '/resume.pdf'</code>。
            </p>
            <span class="btn disabled">下载简历（暂不可用）</span>
          </>
        )
      }
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">最新文章 <span class="en">blog</span></h2>
    <PostList posts={latestPosts} />
    <p><a class="mono" href="/blog/">查看全部文章 →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 24px;
  }
  .whoami {
    margin: 0 0 4px;
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }
  .name-en {
    font-size: 0.45em;
    color: var(--text-dim);
    font-weight: 400;
    letter-spacing: 0;
    margin-left: 6px;
  }
  .pitch {
    font-size: 1.2rem;
    margin: 0 0 6px;
  }
  .pitch::before {
    content: '> ';
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .status {
    margin: 0 0 16px;
  }
  .targets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    font-size: 0.9rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 20px;
    border-left: 2px solid var(--border);
  }
  .timeline-item {
    position: relative;
    padding: 0 0 28px;
  }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .timeline-item.edu::before {
    border-color: var(--accent-2);
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
  }
  .timeline-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .role {
    font-weight: 400;
    color: var(--text-dim);
  }
  .period {
    font-size: 0.85rem;
  }
  .highlights {
    margin: 8px 0 10px;
    padding-left: 20px;
    color: var(--text-dim);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .project {
    display: flex;
    flex-direction: column;
  }
  .project.placeholder {
    border-style: dashed;
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }
  .project-cat {
    color: var(--accent);
  }
  .project h3 {
    margin: 8px 0 6px;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .project p {
    margin: 0 0 12px;
    font-size: 0.9rem;
    flex: 1;
  }
  .project-links {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    font-size: 0.85rem;
  }

  .skills {
    margin: 0;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 12px;
    padding: 8px 0;
    align-items: center;
  }
  .skill-row + .skill-row {
    border-top: 1px dashed var(--border);
  }
  .skill-row dt {
    color: var(--accent-2);
    font-size: 0.9rem;
  }
  .skill-row dd {
    margin: 0;
  }

  .resume p {
    margin-top: 0;
  }
</style>
